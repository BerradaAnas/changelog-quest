{
  "name": "changelog-quest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "validate": "pnpm --filter @cq/pipeline validate",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate && pnpm build",
    "source": "pnpm --filter @cq/pipeline run source",
    "ingest": "pnpm --filter @cq/pipeline run ingest",
    "build": "pnpm --filter @cq/site build",
    "dev": "pnpm --filter @cq/site dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
