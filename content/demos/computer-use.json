{
  "featureId": "computer-use",
  "title": "Can Claude use your screen?",
  "intro": "Pick your setup.",
  "kind": "choose",
  "inputs": [
    {
      "id": "c",
      "label": "Setup",
      "options": [
        "Terminal on macOS, Pro plan",
        "Terminal on Linux",
        "claude -p in a script"
      ]
    }
  ],
  "rules": [
    {
      "when": [
        {
          "input": "c",
          "equals": "Terminal on macOS, Pro plan"
        }
      ],
      "show": {
        "title": "Yes, after setup",
        "detail": "Enable the computer-use server in /mcp, grant Accessibility and Screen Recording, and approve each app Claude asks for.",
        "outcome": "success",
        "trace": [
          {
            "who": "You",
            "text": "/mcp",
            "code": true
          },
          {
            "who": "You",
            "text": "Enable computer-use."
          },
          {
            "who": "Claude Code",
            "text": "Asks to use the app you're testing."
          }
        ]
      }
    },
    {
      "when": [
        {
          "input": "c",
          "equals": "Terminal on Linux"
        }
      ],
      "show": {
        "title": "Not in the terminal",
        "detail": "In the terminal, computer use is macOS only.",
        "outcome": "blocked",
        "trace": [
          {
            "who": "Claude Code",
            "text": "Not available on this system."
          }
        ]
      }
    },
    {
      "when": [
        {
          "input": "c",
          "equals": "claude -p in a script"
        }
      ],
      "show": {
        "title": "Not available",
        "detail": "It needs an interactive session.",
        "outcome": "blocked",
        "trace": [
          {
            "who": "Claude Code",
            "text": "Computer use isn't available in -p mode."
          }
        ]
      }
    }
  ],
  "fallback": {
    "title": "Pick an option",
    "detail": "Choose one of the options to see what happens."
  },
  "quiz": {
    "question": "How do you stop Claude while it's controlling the screen?",
    "options": [
      "Close the laptop",
      "Press Esc or Ctrl+C",
      "Run /stop"
    ],
    "answerIndex": 1,
    "explanation": "Esc or Ctrl+C stops it."
  },
  "status": "approved"
}
