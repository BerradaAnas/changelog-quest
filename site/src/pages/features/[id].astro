---
import Demo from "../../components/Demo.astro";
import DocNav from "../../components/DocNav.astro";
import Base from "../../layouts/Base.astro";
import {
  demos,
  featureById,
  features,
  includeDrafts,
  releaseByVersion,
  summaries,
} from "../../lib/content";
import { EVENT_LABELS, featureView } from "../../lib/features";
import { releaseDate } from "../../lib/format";
import { placeOf } from "../../lib/sections";

export function getStaticPaths() {
  return features.map((feature) => ({ params: { id: feature.id }, props: { feature } }));
}

const view = featureView(Astro.props.feature, {
  releases: releaseByVersion,
  summaries,
  demos,
  includeDrafts,
});
const { feature, history, demo } = view;
const place = placeOf(feature.id, new Set(featureById.keys()));
const prev = place.prev ? featureById.get(place.prev) : undefined;
const next = place.next ? featureById.get(place.next) : undefined;
const toc = [
  { id: "what", label: "What it is" },
  ...(feature.impact.length > 0 ? [{ id: "why", label: "Why it matters" }] : []),
  ...(feature.howItWorks.length > 0 ? [{ id: "how", label: "How it works" }] : []),
  { id: "try", label: demo ? "Try it yourself" : "Hands-on example" },
  { id: "history", label: "Update history" },
  { id: "docs", label: "Official documentation" },
];
const docLabel = (url: string) =>
  new URL(url).pathname.replace(/^\/docs\/en\//, "").replace(/\/$/, "");
---

<Base title={`${feature.name} in Claude Code | Changelog Quest`} description={feature.summary} wide>
  <div class="doc-layout">
  <nav class="doc-nav" aria-label="All features">
    <details class="doc-nav-mobile">
      <summary>Browse all features</summary>
      <DocNav current={feature.id} />
    </details>
    <div class="doc-nav-desktop">
      <DocNav current={feature.id} />
    </div>
  </nav>
  <article class="feature" data-area={feature.area} data-pagefind-body>
    <header class="hero">
      <p class="back-home"><a href="/">← Back to home</a></p>
      <p class="kicker">
        <a href="/features/">Features</a> · {place.section?.label} · since version {view.introducedIn}
        {feature.status !== "active" && <span class="tag">{feature.status}</span>}
      </p>
      <h1>{feature.name}</h1>
      <p>{feature.summary}</p>
    </header>

    <section aria-labelledby="what">
      <h2 id="what">What it is</h2>
      <p>{feature.what}</p>
    </section>

    {
      feature.impact.length > 0 && (
        <section aria-labelledby="why">
          <h2 id="why">Why it matters</h2>
          <ul class="impact">
            {feature.impact.map((i) => (
              <li>
                <strong>{i.title}</strong>
                <span>{i.detail}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      feature.howItWorks.length > 0 && (
        <section aria-labelledby="how">
          <h2 id="how">How it works</h2>
          <ol class="steps">
            {feature.howItWorks.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        </section>
      )
    }

    <div id="try" class="anchor" />
    {
      demo ? (
        <Demo demo={demo} />
      ) : (
        <section class="demo demo-empty" data-pagefind-ignore>
          <h2>Hands-on example coming</h2>
          <p>This feature has no reviewed example yet. The official documentation below has the details.</p>
        </section>
      )
    }

    <details class="history-box">
      <summary>
        <span class="history-head">
          <h2 id="history">Update history</h2>
          <span class="history-count">{history.length === 1 ? "1 version" : `${history.length} versions`}</span>
        </span>
        <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
      </summary>
      <ol class="history">
        {
          history.map((h) => (
            <li>
              <p class="kicker">
                <a href={`/releases/${h.version}/`}>Version {h.version}</a> ·{" "}
                {releaseDate(h.publishedAt, h.estimated)}
              </p>
              {h.events.map((e) => (
                <p>
                  <span class="tag">{EVENT_LABELS[e.type]}</span> {e.note}
                </p>
              ))}
              {h.lines.length > 0 && (
                <details class="history-lines">
                  <summary>{h.lines.length === 1 ? "1 related change" : `${h.lines.length} related changes`}</summary>
                  <ul>
                    {h.lines.map((l) => (
                      <li>{l.text}</li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          ))
        }
      </ol>
    </details>

    <section aria-labelledby="docs">
      <h2 id="docs">Official documentation</h2>
      <ul class="docs">
        {
          feature.docUrls.map((url) => (
            <li>
              <a href={url} rel="noopener">
                {docLabel(url)} ↗
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <nav class="pager" aria-label="Previous and next feature">
      {prev ? <a href={`/features/${prev.id}/`}>← {prev.name}</a> : <span />}
      {next ? <a href={`/features/${next.id}/`}>{next.name} →</a> : <span />}
    </nav>
    <p class="back-home"><a href="/">← Back to home</a></p>
  </article>
  <nav class="doc-toc" aria-label="On this page">
    <p class="doc-toc-title">On this page</p>
    <ul>
      {toc.map((t) => (
        <li>
          <a href={`#${t.id}`}>{t.label}</a>
        </li>
      ))}
    </ul>
  </nav>
  </div>
</Base>
