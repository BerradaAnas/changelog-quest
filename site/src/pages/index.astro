---
import { SUMMARY_CUTOFF } from "@cq/schemas";
import FeatureGroups from "../components/FeatureGroups.astro";
import WeekCard from "../components/WeekCard.astro";
import Base from "../layouts/Base.astro";
import { features, includeDrafts, releases, summaries } from "../lib/content";
import { monthLabel, shortDate } from "../lib/format";
import { buildTimeline, timelineStats } from "../lib/timeline";

const months = buildTimeline(releases, summaries, includeDrafts, SUMMARY_CUTOFF);
const stats = timelineStats(months);
---

<Base
  title="Changelog Quest: every Claude Code update"
  description="Every Claude Code release, grouped by week, summarized in plain words, and linked to the official changelog."
>
  <section class="hero">
    <h1>Every Claude Code update, in plain words.</h1>
    <p>
      We follow the official Claude Code changelog. Each release is summarized in our own words with
      nothing left out, and links back to the original.
    </p>
    <p class="hero-actions">
      <a class="cta" href="/features/">Explore the features</a>
      <a class="soft" href="#timeline">See recent releases</a>
    </p>
    <p class="stats">
      {stats.releases} releases since {shortDate(SUMMARY_CUTOFF)} · {stats.summarized} summarized, newest first
    </p>
  </section>

  {
    features.length > 0 && (
      <section class="block" aria-labelledby="features">
        <div class="block-head">
          <h2 id="features">Features explained</h2>
          <a href="/features/">All features</a>
        </div>
        <FeatureGroups level={3} />
      </section>
    )
  }

  <section class="block" aria-labelledby="timeline">
    <div class="block-head">
      <h2 id="timeline">Release timeline</h2>
      <a href="/search/">Search</a>
    </div>
    {
      months.map((m) => (
        <section class="month" aria-labelledby={`m-${m.month}`}>
          <h3 id={`m-${m.month}`}>{monthLabel(m.month)}</h3>
          {m.cards.map((card) => (
            <WeekCard card={card} />
          ))}
        </section>
      ))
    }
    <p class="older">
      Older releases are in the
      <a href="https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md">official changelog</a>.
    </p>
  </section>
</Base>
