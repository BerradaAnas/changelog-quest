---
import "@fontsource/atkinson-hyperlegible-next/400.css";
import "@fontsource/atkinson-hyperlegible-next/400-italic.css";
import "@fontsource/atkinson-hyperlegible-next/700.css";
import "@fontsource/source-serif-4/600.css";
import "../styles/global.css";
import { SITE_NAME } from "../lib/content";

interface Props {
  title: string;
  description: string;
  /** Wider main column, for pages with side navigation. */
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const current = (prefix: string) => (path.startsWith(prefix) ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} releases`} href="/rss.xml" />
    <title>{title}</title>
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/"><strong>{SITE_NAME}</strong><span>for Claude Code</span></a>
        <nav aria-label="Main">
          <a href="/#timeline">Releases</a>
          <a href="/features/" aria-current={current("/features/")}>Features</a>
          <a href="/search/" aria-current={current("/search/")}>Search</a>
          <button type="button" class="theme-toggle" data-theme-toggle data-mode="system" aria-label="Theme: system" title="Theme: system" hidden>
            <svg class="icon icon-system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>
            <svg class="icon icon-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="icon icon-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main" class:list={["wrap", { wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>Independent open-source project, not affiliated with or endorsed by Anthropic.</span>
        <span>
          Summaries are written in our own words. The original changelog belongs to Anthropic and is
          linked from every release.
        </span>
        <nav aria-label="External links">
          <a href="https://code.claude.com/docs/en/overview">Claude Code docs</a>
          <a href="https://github.com/anthropics/claude-code/blob/main/CHANGELOG.md">Official changelog</a>
          <a href="https://github.com/BerradaAnas/changelog-quest">Source</a>
        </nav>
      </div>
    </footer>
    <script>
      import "../scripts/theme.ts";
    </script>
  </body>
</html>
