---
import { demos, features, includeDrafts, releaseByVersion, summaries } from "../lib/content";
import { featuresByArea, featureView } from "../lib/features";
import FeatureCard from "./FeatureCard.astro";

interface Props {
  /** Heading level of each area title. */
  level: 2 | 3;
}
const { level } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
const ctx = { releases: releaseByVersion, summaries, demos, includeDrafts };
const groups = featuresByArea(features.map((f) => featureView(f, ctx)));
---

{
  groups.map((g) => (
    <section class="area" data-area={g.area} aria-labelledby={`area-${g.area}`}>
      <Heading id={`area-${g.area}`}>{g.label}</Heading>
      <p class="blurb">{g.blurb}</p>
      <ul class="feature-grid">
        {g.features.map((v) => (
          <FeatureCard feature={v.feature} introducedIn={v.introducedIn} hasDemo={Boolean(v.demo)} />
        ))}
      </ul>
    </section>
  ))
}
<script>
  import "../scripts/progress-badges.ts";
</script>
