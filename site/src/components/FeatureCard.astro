---
import type { Feature } from "@cq/schemas";

interface Props {
  feature: Feature;
  introducedIn: string;
  /** Status of the feature's demo when it is shown, undefined when there is none. */
  demo?: "draft" | "approved";
}
const { feature, introducedIn, demo } = Astro.props;
---

<li class="feature-card" data-area={feature.area}>
  <a href={`/features/${feature.id}/`}>{feature.name}</a>
  <p>{feature.summary}</p>
  <p class="meta">
    <span>Since {introducedIn}</span>
    {feature.status !== "active" && <span class="tag">{feature.status}</span>}
    {demo === "approved" && <span class="tag has-demo">Hands-on example</span>}
    {demo === "draft" && <span class="tag has-demo draft">Hands-on example (draft)</span>}
    {!demo && <span class="tag no-demo">No example yet</span>}
    <span class="tag done" data-progress-for={feature.id} hidden></span>
  </p>
</li>
